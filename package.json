{
  "name": "erp-studio",
  "version": "0.1.0",
  "private": true,
  "description": "BALTACIOĞLU'S ERP Studio: mobilya üretimi için stok, sipariş, üretim ve satın alma yönetimi (vitrin sürümü)",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "node scripts/db-generate.mjs && npm run seed:snapshot",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "seed:snapshot": "vitest run --config vitest.gen.config.mts scripts/gen/snapshot.gen.ts",
    "catalog:export": "vitest run --config vitest.gen.config.mts scripts/gen/catalog.gen.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@tanstack/react-query": "5.107.1",
    "cmdk": "1.1.1",
    "drizzle-orm": "0.45.4",
    "motion": "14.8.0",
    "next": "16.4.5",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
